@model ProyectoFinal.Models.Pregunta

@{
    ViewData["Title"] = "Borrar Pregunta";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h3>⚠️ ¿Estás seguro?</h3>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title">Vas a eliminar esta pregunta:</h5>
                    <h2 class="text-danger my-4">"@Model.Titulo"</h2>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger btn-lg">Sí, Eliminar</button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>