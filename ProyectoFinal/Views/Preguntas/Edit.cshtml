@model ProyectoFinal.Models.Pregunta

@{
    ViewData["Title"] = "Editar Pregunta";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3>Editar Pregunta</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Pregunta</label>
                            <input asp-for="Titulo" class="form-control form-control-lg" />
                        </div>

                        <hr />
                        <h5 class="mb-3 text-secondary">Respuestas y Puntos</h5>

                        <div class="row mb-2">
                            <div class="col-8"><input asp-for="Respuesta1" class="form-control" /></div>
                            <div class="col-4"><input asp-for="Puntos1" class="form-control" type="number" /></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-8"><input asp-for="Respuesta2" class="form-control" /></div>
                            <div class="col-4"><input asp-for="Puntos2" class="form-control" type="number" /></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-8"><input asp-for="Respuesta3" class="form-control" /></div>
                            <div class="col-4"><input asp-for="Puntos3" class="form-control" type="number" /></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-8"><input asp-for="Respuesta4" class="form-control" /></div>
                            <div class="col-4"><input asp-for="Puntos4" class="form-control" type="number" /></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-8"><input asp-for="Respuesta5" class="form-control" /></div>
                            <div class="col-4"><input asp-for="Puntos5" class="form-control" type="number" /></div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-warning btn-lg">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>