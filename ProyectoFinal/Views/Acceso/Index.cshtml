@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>100 Cimarrones Dijeron</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #00723F 0%, #024731 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Arial Black', sans-serif;
            margin: 0;
        }

        .login-card {
            background: white;
            padding: 40px;
            border-radius: 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
            width: 450px;
            text-align: center;
            border: 6px solid #FEBE10;
        }

        .btn-jugador {
            background: #FEBE10;
            color: #024731;
            font-size: 2rem;
            padding: 15px;
            border-radius: 20px;
            border: 4px solid #024731;
            width: 100%;
            margin-bottom: 30px;
            transition: 0.3s;
        }

            .btn-jugador:hover {
                transform: scale(1.05);
                background: #f0b000;
            }

        .admin-box {
            border-top: 2px dashed #ccc;
            padding-top: 20px;
        }

        .btn-admin {
            background: #00723F;
            color: white;
            width: 100%;
            font-weight: bold;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h1 style="color: #00723F; font-size: 4rem; margin:0;">100</h1>
        <h2 style="color: #00723F; margin:0;">CIMARRONES</h2>
        <p style="color: #FEBE10; font-size: 1.5rem; -webkit-text-stroke: 0.5px black;">DIJERON</p>

        <form asp-action="EntrarComoJugador" method="post">
            <button type="submit" class="btn btn-jugador">🎮 ¡A JUGAR!</button>
        </form>

        <div class="admin-box">
            <small class="text-muted d-block mb-2">MODO ADMINISTRADOR</small>
            <form asp-action="LoginAdmin" method="post">
                <input type="text" name="usuario" class="form-control mb-2 text-center" placeholder="Usuario" required>
                <input type="password" name="password" class="form-control mb-2 text-center" placeholder="Contraseña" required>
                <button type="submit" class="btn btn-admin p-2">ENTRAR AL PANEL</button>
            </form>
            @if (ViewBag.Error != null)
            {
                <p class="text-danger mt-2 small">@ViewBag.Error</p>
            }
        </div>
    </div>
</body>
</html>